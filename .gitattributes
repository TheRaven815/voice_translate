# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and documentation files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.spec text eol=lf
*.txt text eol=lf

# Binary assets
*.ico binary
*.png binary
*.exe binary
